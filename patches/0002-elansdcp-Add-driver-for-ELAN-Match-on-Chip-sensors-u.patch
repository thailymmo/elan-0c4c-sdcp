+++ b/libfprint/drivers/elansdcp/elansdcp.c
@@ -0,0 +1,732 @@
+/*
+ * Driver for ELAN Match-on-Chip sensors using SDCP (04f3:0c4c, FW 3.05)
+ *
+ * The protocol was derived from the Windows WBF driver for this sensor
+ * (WbfUsbDriver.dll 3.2.12011.10039), which wraps the ELAN MoC command set
+ * used by the elanmoc2 driver with the Microsoft Secure Device Connection
+ * Protocol. Without an SDCP session the sensor refuses to commit templates.
+ *
