+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#pragma once
+
+#include "fpi-device.h"
+#include "fpi-sdcp-device.h"
+#include "fpi-ssm.h"
+
+#define ELANSDCP_EP_CMD_OUT (0x01 | FPI_USB_ENDPOINT_OUT)
+#define ELANSDCP_EP_CMD_IN (0x03 | FPI_USB_ENDPOINT_IN)
+#define ELANSDCP_EP_MOC_IN (0x04 | FPI_USB_ENDPOINT_IN)
+
+#define ELANSDCP_CMD_TIMEOUT 5000
+#define ELANSDCP_WIPE_TIMEOUT 10000
+#define ELANSDCP_ENROLL_STAGES 8
+#define ELANSDCP_MAX_PRINTS 10
+
+/* Every command is 0x40 0xff <code> [payload] */
+#define ELANSDCP_CMD_HDR_LEN 3
+
+#define ELANSDCP_CMD_ENROLL 0x01
+#define ELANSDCP_CMD_ABORT 0x02
+#define ELANSDCP_CMD_IDENTIFY 0x03
+#define ELANSDCP_CMD_ENROLLED_COUNT 0x04
+#define ELANSDCP_CMD_SDCP_CONNECT 0x06
+#define ELANSDCP_CMD_SDCP_RECONNECT 0x07
+#define ELANSDCP_CMD_SDCP_ENROLL_NONCE 0x09
+#define ELANSDCP_CMD_SDCP_ENROLL_COMMIT 0x0a
+#define ELANSDCP_CMD_SDCP_AUTHORIZED_ID 0x0c
+#define ELANSDCP_CMD_WIPE 0x99
+
+/* Status byte (second byte of every reply) */
+#define ELANSDCP_RESP_OK 0x00
+#define ELANSDCP_RESP_MOVE_DOWN 0x41
+#define ELANSDCP_RESP_MOVE_RIGHT 0x42
+#define ELANSDCP_RESP_MOVE_UP 0x43
+#define ELANSDCP_RESP_MOVE_LEFT 0x44
+#define ELANSDCP_RESP_SENSOR_DIRTY 0xfb
+#define ELANSDCP_RESP_NOT_MATCHED 0xfd
+#define ELANSDCP_RESP_NOT_ENOUGH_SURFACE 0xfe
+
+/* r_d | pk_d | pk_f | h_f | mac | s_m | s_d | cert_m */
+#define ELANSDCP_CERT_M_SIZE 846
+#define ELANSDCP_CONNECT_RESP_LEN (2 + SDCP_RANDOM_SIZE + 2 * SDCP_PUBLIC_KEY_SIZE + \
+                                   SDCP_RANDOM_SIZE + SDCP_MAC_SIZE + \
+                                   2 * SDCP_SIGNATURE_SIZE + ELANSDCP_CERT_M_SIZE)
+
+G_DECLARE_FINAL_TYPE (FpiDeviceElanSdcp, fpi_device_elansdcp, FPI, DEVICE_ELANSDCP, FpSdcpDevice)
+
+typedef void (*ElanSdcpCmdCallback) (FpiDeviceElanSdcp *self,
+                                     const guint8      *data,
+                                     gsize              length,
+                                     GError            *error);
+
+enum enroll_states {
+  ENROLL_GET_COUNT,
+  ENROLL_CAPTURE,
+  ENROLL_GET_NONCE,
+  ENROLL_NUM_STATES,
+};
+
+enum identify_states {
+  IDENTIFY_WAIT_FINGER,
+  IDENTIFY_GET_AUTHORIZED_ID,
+  IDENTIFY_NUM_STATES,
+};
+
+enum clear_storage_states {
+  CLEAR_STORAGE_WIPE,
+  CLEAR_STORAGE_CHECK,
+  CLEAR_STORAGE_NUM_STATES,
+};
+
+struct _FpiDeviceElanSdcp
+{
+  FpSdcpDevice parent;
+  FpiSsm      *task_ssm;
+  guint8       enrolled_num;
+  guint8       enroll_stage;
+};
